#!/usr/bin/env node
const API=process.env.ONE_DB_API_URL||process.env.DB_API_URL||'https://1db.io';
const KEY=process.env.ONE_DB_API_KEY||process.env.DB_API_KEY||process.env['1DB_API_KEY'];
const TENANT=process.env.ONE_DB_TENANT_UID||process.env.NRUN_TENANT_UID||process.env['1DB_TENANT_UID'];
const args=process.argv.slice(2);
function usage(){console.log(`1db CLI\n\nUsage:\n  1db links create --code demo --url https://example.com\n  1db links list\n  1db intakes create --slug waitlist --name Waitlist\n  1db cognition graph get --namespace 1db\n  1db cognition seed --namespace 1db --word cold\n  1db cognition decompose --namespace 1db cold\n  1db cognition infer --namespace 1db --input water=1.0,cold=0.25\n  1db cognition explain --namespace 1db --session SESSION_ID\n\nEnv:\n  ONE_DB_API_KEY=1db_live_...\n  ONE_DB_TENANT_UID=23a774eb-...\n  ONE_DB_API_URL=https://1db.io`)}
function opt(n){const i=args.indexOf(n);return i>=0?args[i+1]:undefined}
function parseInput(value){return Object.fromEntries(String(value||'').split(',').filter(Boolean).map(pair=>{const [k,v]=pair.split('=');return [k,Number(v)]}))}
async function call(path,method='GET',body,headers={}){const r=await fetch(API+path,{method,headers:{...(KEY?{authorization:`Bearer ${KEY}`}:{ }),'content-type':'application/json',...headers},body:body?JSON.stringify(body):undefined}); const j=await r.json().catch(()=>({})); if(!r.ok){console.error(JSON.stringify(j,null,2));process.exit(1)} console.log(JSON.stringify(j,null,2))}
function cognitionHeaders(){if(!TENANT){console.error('Missing ONE_DB_TENANT_UID');process.exit(2)} return {'X-NRun-Tenant-Uid':TENANT}}
(async()=>{if(args.length===0||args.includes('--help'))return usage(); if(args[0]==='links'&&args[1]==='create'){if(!KEY){console.error('Missing ONE_DB_API_KEY');process.exit(2)} return call('/api/v1/links','POST',{code:opt('--code'),destinationUrl:opt('--url')||opt('--destination-url'),tags:(opt('--tags')||'').split(',').filter(Boolean)})} if(args[0]==='links'&&args[1]==='list'){if(!KEY){console.error('Missing ONE_DB_API_KEY');process.exit(2)} return call('/api/v1/links')} if(args[0]==='intakes'&&args[1]==='create'){if(!KEY){console.error('Missing ONE_DB_API_KEY');process.exit(2)} return call('/api/v1/intakes','POST',{slug:opt('--slug'),name:opt('--name')||opt('--slug')})} if(args[0]==='cognition'&&args[1]==='graph'&&args[2]==='get')return call('/api/v1/cognition/graph?namespace='+encodeURIComponent(opt('--namespace')||'1db'),'GET',undefined,cognitionHeaders()); if(args[0]==='cognition'&&args[1]==='seed')return call('/api/v1/cognition/seed','POST',{namespace:opt('--namespace')||'1db',graphId:opt('--graph')||'1db-base-cognition',domain:opt('--domain'),word:opt('--word')},cognitionHeaders()); if(args[0]==='cognition'&&args[1]==='decompose')return call('/api/v1/cognition/decompose/'+encodeURIComponent(args.find((a,i)=>i>1&&!a.startsWith('--')&&args[i-1]!=='--namespace')||opt('--word')||'cold'),'GET',undefined,cognitionHeaders()); if(args[0]==='cognition'&&args[1]==='infer')return call('/api/v1/cognition/infer','POST',{namespace:opt('--namespace')||'1db',input:parseInput(opt('--input'))},cognitionHeaders()); if(args[0]==='cognition'&&args[1]==='explain')return call('/api/v1/cognition/sessions/'+encodeURIComponent(opt('--session')||args[2]||'')+'/explanation','GET',undefined,cognitionHeaders()); usage();})();
